{
  "name": "console-web-node",
  "version": "0.1.0",
  "description": "Guarda em memória as últimas linhas do console de um servidor Node/Express e permite acompanhá-las de outra máquina (npx console-web-node <servidor>)",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "console-web-node": "src/client.js"
  },
  "files": [
    "src",
    "!src/**/*.test.js"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "start": "nodemon",
    "test:watch": "nodemon -x mocha -p 'src/**/*.test.js'",
    "test": "mocha -p 'src/**/*.test.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonardoRomeiro/console-web-node.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LeonardoRomeiro/console-web-node/issues"
  },
  "homepage": "https://github.com/LeonardoRomeiro/console-web-node#readme",
  "devDependencies": {
    "chai": "^4.2.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.14"
  }
}
